# Copy to .deploy-yandex.env (Git-ignored). Resource IDs only; NO secret values.
YC_BUCKET=pravdarula.ru
YC_FUNCTION_ID=
YC_GATEWAY_ID=
YC_RUNTIME_SA_ID=
YC_AUTH_SECRET_ID=
YC_PAY_SECRET_ID=
YDB_CONNECTION_STRING=
APP_BASE_URL=https://pravdarula.ru
# Optional checks: if supplied, each value MUST equal the existing Function configuration.
YANDEX_PAY_ENV=sandbox
YANDEX_PAY_MERCHANT_ID=
POSTBOX_FROM_EMAIL=no-reply@auth.pravdarula.ru
# APP_ORIGINS=
# APP_PREVIEW_ORIGIN=
# Restricted local file containing an IAM access token for read-only YDB schema checks.
# Obtain/refresh through your existing IAM workflow. Never commit or print its contents.
YDB_TOKEN_FILE=
# Exact-commit local compatibility evidence; required for API/Gateway/migration changes.
RELEASE_COMPATIBILITY_FILE=
# Explicit exact-commit/file-hash review of otherwise unknown paths (metadata only).
# Unsupported server routes or infrastructure still require implementation, not approval.
RELEASE_PATH_REVIEW_FILE=
