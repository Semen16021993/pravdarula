# Local-only values for development and tests. Production secrets are stored in Yandex Lockbox.
YDB_CONNECTION_STRING=grpcs://ydb.serverless.yandexcloud.net:2135/?database=/ru-central1/YOUR_CLOUD_ID/YOUR_DATABASE_ID
APP_BASE_URL=http://localhost:5173
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
POSTBOX_FROM_EMAIL=no-reply@auth.pravdarula.ru
YANDEX_PAY_ENV=sandbox

# Do not commit real values. Production AUTH_SECRET and YANDEX_PAY_API_KEY belong in Yandex Lockbox.
AUTH_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
YANDEX_PAY_API_KEY=REPLACE_WITH_MERCHANT_API_KEY
